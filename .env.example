# Configuración del servidor
NODE_ENV=development
PORT=8080

# Base de datos (completar con tu URI real)
MONGODB_URI=

# Seguridad y servicios externos (completar con tus claves reales)
JWT_SECRET=
SHIPPING_API_KEY=

# Nota para Testing: Para ejecutar 'npm test', crear un archivo .env.test en la raíz
# con estas mismas variables apuntando a una base de datos de pruebas (ej. .../shipnow_test) y NODE_ENV=test.
LOG_LEVEL=debug
SHIPPING_SERVICE_URL=https://api.shipping-external.local
